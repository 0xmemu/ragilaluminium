[Unit]
Description=Laravel Reverb WebSocket server (admin live events) - ragilaluminium.com
After=network.target redis-server.service
Wants=redis-server.service
# Tanpa batas laju: server WebSocket harus selalu hidup lagi, apa pun sebab
# berhentinya. Restart=on-failure sebelumnya tidak menghidupkan proses yang
# berhenti bersih (kode keluar 0), sehingga admin berhenti menerima pembaruan
# tanpa gejala apa pun.
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ragilaluminium/current
ExecStart=/usr/bin/php /var/www/ragilaluminium/current/artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3
# Log ke folder bersama (shared), bukan folder rilis. Folder rilis diganti tiap
# deploy, sehingga log di sana hilang.
StandardOutput=append:/var/www/ragilaluminium/shared/storage/logs/reverb.log
StandardError=append:/var/www/ragilaluminium/shared/storage/logs/reverb.log

[Install]
WantedBy=multi-user.target
