APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (Cloudflare R2) — isi saat VPS; lokal biarkan kosong + MEDIA_DISK=local ---
# Dashboard: R2 bucket + API token (Object Read & Write) + custom domain publik
# AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_URL=https://media.ragilaluminium.com   ← URL yang dibuka browser (bukan endpoint API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
# R2: set true. S3 klasik sering false.
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ==========================================================================
# CATATAN PRODUKSI: set APP_DEBUG=false dan APP_ENV=production saat live.
# Pertimbangkan SESSION_ENCRYPT=true untuk sesi admin.
# ==========================================================================

# --- WhatsApp Business API ---
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_LANGUAGE=id
WHATSAPP_TIMEOUT=15

# --- Pengiriman (fallback lokal saat J&T nonaktif) ---
SHIPPING_LOCAL_BASE_RATE=15000
SHIPPING_LOCAL_PER_KG=2000
SHIPPING_DEFAULT_ITEM_WEIGHT=1.0

# --- J&T Cargo Open Platform (https://open.jtcargo.co.id/#/apiDoc) ---
JNT_ENABLED=false
JNT_ENV=sandbox
JNT_SANDBOX_BASE_URL=https://demoopenapi.jtcargo.co.id
JNT_PRODUCTION_BASE_URL=https://openapi.jtcargo.co.id
JNT_API_ACCOUNT=
JNT_PRIVATE_KEY=
JNT_CUSTOMER_CODE=
JNT_CUSTOMER_PASSWORD=
JNT_WEBHOOK_PRIVATE_KEY=
# Default order/pengirim (sesuaikan dgn akun J&T)
JNT_EXPRESS_TYPE=FTAIR
JNT_ORDER_TYPE=2
JNT_SERVICE_TYPE=01
JNT_DELIVERY_TYPE=101
JNT_PAY_TYPE=PP_PM
JNT_PAY_TYPE_COD=CC_CASH
JNT_GOODS_TYPE=bm000010
JNT_PAYMENT_TYPE=2
JNT_SENDER_NAME="Ragil Aluminium"
JNT_SENDER_COMPANY="Ragil Aluminium"
JNT_SENDER_MOBILE=
JNT_SENDER_PHONE=
JNT_SENDER_PROV=
JNT_SENDER_CITY=
JNT_SENDER_AREA=
JNT_SENDER_ADDRESS=
JNT_SENDER_POSTCODE=
# Data uji joint-debugging sandbox
JNT_TEST_DEST_PROV="DKI JAKARTA"
JNT_TEST_DEST_CITY=JAKARTA
JNT_TEST_DEST_AREA="JAKARTA PUSAT"
JNT_TEST_DEST_POSTCODE=10110
JNT_TEST_RECEIVER_MOBILE=08123456789
JNT_TEST_BILLCODE=

# --- Ingest Media (impor gambar Shopee) ---
# MEDIA_DISK=local (dev) | s3 (VPS + Cloudflare R2 — isi AWS_* di atas)
MEDIA_DISK=local
# Di VPS: MEDIA_DISK=s3 dan MEDIA_ALLOW_SOURCE_FALLBACK=false
MEDIA_ALLOWED_HOSTS=cf.shopee.co.id,down-id.img.susercontent.com,cvws.img.susercontent.com,deo.shopeemobile.com
MEDIA_MAX_BYTES=10485760
MEDIA_DOWNLOAD_TIMEOUT=60
# false in production so catalog never hotlinks Shopee CDN
MEDIA_ALLOW_SOURCE_FALLBACK=true
MEDIA_DERIV_THUMB=400
MEDIA_DERIV_CARD=800
MEDIA_DERIV_PDP=1400
MEDIA_WEBP_QUALITY=82
# false = jangan simpan JPG/PNG berat; stored_path = WebP pdp (hemat R2)
MEDIA_KEEP_ORIGINAL=false
MEDIA_PLACEHOLDER=images/home/product-flash.png
# Smoke: php artisan media:disk-check

# --- Event storefront ---
# Persentase diskon kartu global; 0 untuk menonaktifkan event.
# Atribut produk promo_compare_price tetap menjadi sumber utama bila tersedia.
STOREFRONT_PRODUCT_CARD_DISCOUNT_PERCENT=0

# --- Footer social / marketplace (Temukan Kami) ---
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
SOCIAL_SHOPEE=
SOCIAL_LAZADA=
SOCIAL_TOKOPEDIA=
